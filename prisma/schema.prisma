generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Category {
  id          Int                    @id @default(autoincrement())
  slug        String                 @unique
  sortOrder   Int                    @default(0)
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  products    Product[]
  translations CategoryTranslation[]
}

model CategoryTranslation {
  id         Int      @id @default(autoincrement())
  categoryId Int
  locale     String
  name       String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Product {
  id            Int                 @id @default(autoincrement())
  slug          String              @unique
  categoryId    Int
  isActive      Boolean             @default(true)
  sortOrder     Int                 @default(0)
  isFeatured    Boolean             @default(false)
  featuredOrder Int?
  category      Category            @relation(fields: [categoryId], references: [id])
  translations  ProductTranslation[]
  media         ProductMedia[]
}

model ProductTranslation {
  id        Int     @id @default(autoincrement())
  productId Int
  locale    String
  name      String
  points    Json
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

model ProductMedia {
  id        Int     @id @default(autoincrement())
  productId Int
  filePath  String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model HeroImage {
  id        Int      @id @default(autoincrement())
  filePath  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id             Int                 @id @default(autoincrement())
  isActive       Boolean             @default(true)
  sortOrder      Int                 @default(0)
  imagePath      String?
  phone          String?
  mobile         String?
  email          String?
  googleEmbedUrl String
  directionsUrl  String?
  translations   BranchTranslation[]
}

model BranchTranslation {
  id        Int     @id @default(autoincrement())
  branchId  Int
  locale    String
  name      String
  address   String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, locale])
}

model CareerSlot {
  id           Int                     @id @default(autoincrement())
  isActive     Boolean                 @default(true)
  sortOrder    Int                     @default(0)
  translations CareerSlotTranslation[]
  applications JobApplication[]
}

model CareerSlotTranslation {
  id           Int         @id @default(autoincrement())
  careerSlotId Int
  locale       String
  title        String
  description  String?
  careerSlot   CareerSlot  @relation(fields: [careerSlotId], references: [id], onDelete: Cascade)

  @@unique([careerSlotId, locale])
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  locale    String
  name      String
  email     String
  title     String
  message   String
  createdAt DateTime @default(now())
}

model JobApplication {
  id           Int        @id @default(autoincrement())
  locale       String
  careerSlotId Int
  fullName     String
  birthDate    DateTime
  bornCity     String
  sex          Sex
  nationality  String
  phoneNumber  String
  email        String
  socialState  SocialState
  cvFilePath   String?
  createdAt    DateTime   @default(now())
  careerSlot   CareerSlot @relation(fields: [careerSlotId], references: [id], onDelete: Cascade)
}

enum Sex {
  male
  female
}

enum SocialState {
  single
  married
}
